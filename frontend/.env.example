# Frontend build env. For Firebase Hosting, set these in the build settings OR
# create .env.local and run `npm run build` before `firebase deploy`.
# Local dev: leave VITE_API_BASE empty -> uses the vite proxy to localhost:8000.
VITE_API_BASE=
# Standby backend (Render) — only used when the primary cannot be reached.
# Production: set to your Render backend URL, e.g.
# VITE_API_FALLBACK_BASE=https://invento-lite-backend.onrender.com/api
VITE_API_FALLBACK_BASE=
