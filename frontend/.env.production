# Production build environment for Invento Lite frontend.
# Vite only reads files named .env, .env.local, .env.production, .env.development
# during `vite build`.  The `.env` file is git-ignored; this file is committed
# so the deployed Firebase build talks to the live VPS backend.
#
# PRIMARY backend (VPS, always tried first):
VITE_API_BASE=https://invento-lite.duckdns.org/api
# STANDBY backend (Render free tier, sleeps when idle). Used ONLY when the VPS
# cannot be reached; the app shows a banner and the user logs in again there
# (tokens are per-server). Render wakes ~30-60s after the first standby call.
VITE_API_FALLBACK_BASE=https://invento-0pap.onrender.com/api
