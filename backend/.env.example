# Copy to .env (never commit). For local dev only.
ENVIRONMENT=development
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_DB=invento
JWT_SECRET=change-me-to-a-long-random-string
