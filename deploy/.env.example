# Copy to production.env and fill in. NEVER commit production.env.
#   cp .env.example production.env

# Public hostname of the VPS backend (DuckDNS subdomain or your own domain).
# The A-record must point at the VPS BEFORE first boot (Caddy needs it for HTTPS).
API_DOMAIN=invento-lite.duckdns.org

ENVIRONMENT=production

# Internal compose-network URI (mongo hostname resolves inside docker).
MONGO_URI=mongodb://mongo:27017/invento?replicaSet=rs0
MONGO_DB=invento

# Generate: openssl rand -hex 32
# TIP: paste the JWT_SECRET from the Render dashboard instead, and all
# existing app logins keep working with zero re-login.
JWT_SECRET=PASTE_RENDER_JWT_SECRET_OR_GENERATE_NEW

# Firebase hosts are also hardcoded as fallback in app/main.py; this covers extras.
CORS_ORIGINS=https://invento-lite.web.app,https://invento-lite.firebaseapp.com

PUBLIC_BASE_URL=https://invento-lite.duckdns.org
